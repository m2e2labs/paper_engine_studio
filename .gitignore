# Node deps for the Playwright tools.
node_modules/

# Local secrets (only needed for `gen-image.mjs --provider gemini`). Never commit.
.env

# Editor settings
.vscode/
.idea/

# Regenerable output. The assembled book.html IS committed (so you can read a
# book on GitHub without building it); the heavy renders are not.
*.pdf

# shot.mjs writes page1.png, page2.png ... into the book's own folder by default.
# Scoped to books/ on purpose: a bare `page*.png` would also swallow documentation
# images like docs/images/page-anatomy.png, silently, and break the README on GitHub.
books/**/page*.png
/page*.png

# Production output. release.mjs writes dated folders of PDFs, proofs and manifests here.
books/**/dist/

# The Studio's working files: proof screenshots and the last preflight report.
# workflow.json (who approved what) is NOT ignored. It is part of the book's history.
books/**/.studio/

# images.mjs keeps the picture it just replaced here, until the next time.
books/**/images/.previous/

# Edition builds are regenerable from book.json.
books/**/book-*.html
